<!-- Modal Overlay -->
<div 
    id="addProductModal" 
    class="fixed inset-0 flex items-center justify-center hidden z-50"
>
    <!-- Modal Container -->
    <div class="bg-gray-50 dark:bg-gray-800 rounded-lg shadow-lg max-w-lg w-full p-6 relative">
        <!-- Header -->
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Input Data Barang</h3>
        </div>

        <!-- Form -->
        <form id="inputDataForm" class="space-y-4 text-gray-900 dark:text-gray-100">
            <!-- Nama Barang -->
            <div>
                <label for="nama_barang" class="block mb-1 font-medium">Nama Barang</label>
                <input 
                    type="text" 
                    id="nama_barang" 
                    name="nama_barang" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                    placeholder="Masukkan nama barang"
                >
            </div>

            <!-- Jenis Barang (input list) -->
            <div>
                <label for="jenis_barang" class="block mb-1 font-medium">Jenis Barang</label>
                <input 
                    list="jenisBarangList" 
                    id="jenis_barang" 
                    name="jenis_barang" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                    placeholder="Ketik atau pilih jenis barang"
                >
                <datalist id="jenisBarangList">
                    <option value="Elektronik"></option>
                    <option value="Makanan"></option>
                    <option value="Pakaian"></option>
                    <option value="Alat Tulis"></option>
                    <!-- Tambah opsi lain sesuai kebutuhan -->
                </datalist>
            </div>

            <!-- Satuan Besar -->
            <div>
                <label for="satuan_besar" class="block mb-1 font-medium">Satuan Besar</label>
                <select 
                    id="satuan_besar" 
                    name="satuan_besar" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                >
                    <option value="" disabled selected>Pilih satuan besar</option>
                    <option value="Dus">Dus</option>
                    <option value="Box">Box</option>
                    <option value="Paket">Paket</option>
                    <!-- Tambah opsi lain sesuai kebutuhan -->
                </select>
            </div>

            <!-- Kapasitas -->
            <div>
                <label for="kapasitas" class="block mb-1 font-medium">Kapasitas</label>
                <input 
                    type="number" 
                    id="kapasitas" 
                    name="kapasitas" 
                    min="1" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                    placeholder="Masukkan kapasitas"
                >
            </div>

            <!-- Satuan Kecil -->
            <div>
                <label for="satuan_kecil" class="block mb-1 font-medium">Satuan Kecil</label>
                <select 
                    id="satuan_kecil" 
                    name="satuan_kecil" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                >
                    <option value="" disabled selected>Pilih satuan kecil</option>
                    <option value="Pcs">Pcs</option>
                    <option value="Botol">Botol</option>
                    <option value="Kg">Kg</option>
                    <!-- Tambah opsi lain sesuai kebutuhan -->
                </select>
            </div>

            <!-- Harga -->
            <div>
                <label for="harga" class="block mb-1 font-medium">Harga</label>
                <input 
                    type="number" 
                    id="harga" 
                    name="harga" 
                    min="0" 
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-indigo-400"
                    placeholder="Masukkan harga"
                >
            </div>

            <!-- Tombol Submit -->
            <div class="flex justify-end space-x-2 pt-4">
                <button 
                    type="button" 
                    id="cancelBtn"
                    class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-400"
                >
                    Batal
                </button>
                <button 
                    type="submit" 
                    class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                >
                    Simpan
                </button>
            </div>
        </form>
    </div>
</div>
