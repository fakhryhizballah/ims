<!DOCTYPE html>
<html lang="id" x-data="themeStore()">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %>- Ims Apps</title>
    <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 dark:bg-dark-bg transition-colors duration-200 overflow-x-hidden">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { page: page }) %>
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header -->
            <%- include('../partials/header', { user: user, title: title }) %>
            
            <!-- Main Content Area -->
            <main class="flex-1 overflow-auto bg-gray-50 dark:bg-dark-bg p-4 sm:p-6 transition-colors duration-200">

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-dark-text">Products Management</h2>
            <p class="text-gray-600">Kelola semua produk</p>
        </div>
        <div class="flex space-x-3">
            <button class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600" id="exportBtn">
                <i class="fas fa-download mr-2"></i>Export
            </button>
            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors dark:hover:bg-indigo-800 dark:bg-indigo-500" id="openModalAddProduct">
                <i class="fas fa-plus mr-2"></i>Add Product
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-dark-surface rounded-lg shadow-sm border border-gray-200 dark:border-gray-600 p-6 transition-colors duration-200">
            <div class="flex items-center">
                <div class="bg-blue-50 p-3 rounded-lg dark:bg-gray-800">
                    <i class="fas fa-box text-blue-600 text-xl dark:text-blue-400"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-600 dark:text-dark-muted">Total Products</p>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-dark-text"><span id="totalProducts"></span></h3>
                </div>
            </div>
        </div>
        
        <div class="bg-white dark:bg-dark-surface rounded-lg shadow-sm border border-gray-200 dark:border-gray-600 p-6 transition-colors duration-200">
            <div class="flex items-center">
                <div class="bg-green-50 p-3 rounded-lg dark:bg-gray-800">
                    <i class="fas fa-solid fa-layer-group text-green-600 text-xl dark:text-green-400"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-600 dark:text-dark-muted">Total Kategori</p>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-dark-text"><span id="totalJenis"></span></h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-dark-surface rounded-lg shadow-sm border border-gray-200 dark:border-gray-600 p-6 transition-colors duration-200">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2 dark:text-dark-muted">Search</label>
                <input id="pencarian" type="text" placeholder="Search products..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2 dark:text-dark-muted">Category</label>
                <select id="categoryFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                    <option value="">All Categories</option>
                </select>
            </div>
        </div>
    </div>
    <!-- Table Container with Responsive Scroll -->
        <div class="overflow-x-auto shadow-lg rounded-lg">
            <table class="w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Nama Barang</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Jenis Barang</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Satuan Besar</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Isi</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Satuan Kecil</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Harga</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700" id="productsTable">
                </tbody>
            </table>
        </div>


</div>

    <%- include('../partials/footer') %>
    <!-- Script buka tutup modal -->
    <%- include('../products/editModal') %>
       <%- include('../products/tambahModal') %>
       <script src="/assets/js/produk/editModal.js"></script>
       <script src="/assets/js/produk/products.js"></script>
     <script src="/assets/js/produk/tambahModal.js"></script>
</body>
</html>