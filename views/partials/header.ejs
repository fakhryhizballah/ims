<header class="bg-white dark:bg-dark-surface shadow-sm border-b border-gray-200 dark:border-gray-600 transition-colors duration-200" x-data="{ mobileMenuOpen: false }">
    <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Mobile menu button -->
            <div class="lg:hidden">
                <button @click="mobileMenuOpen = !mobileMenuOpen" class="p-2 rounded-md text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-colors">
                    <span class="sr-only">Open main menu</span>
                    <i class="fas fa-bars text-lg" x-show="!mobileMenuOpen"></i>
                    <i class="fas fa-times text-lg" x-show="mobileMenuOpen" style="display: none;"></i>
                </button>
            </div>

            <!-- Logo and Title -->
            <div class="flex items-center flex-1 lg:flex-initial">
                <div class="lg:hidden flex items-center justify-center flex-1">
                    <div class="flex items-center">
                        <i class="fas fa-cube text-indigo-600 dark:text-indigo-400 text-xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-900 dark:text-dark-text">MyApp</span>
                    </div>
                </div>
                <div class="hidden lg:block">
                    <h1 class="text-2xl font-semibold text-gray-900 dark:text-dark-text"><%= title %></h1>
                </div>
            </div>
            
            <!-- Desktop Navigation & User Menu -->
            <div class="flex items-center space-x-4">
                <!-- Search Bar - Hidden on mobile -->
                <div class="hidden md:block">
                    <div class="relative">
                        <input type="text" placeholder="Search..." class="w-64 pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text placeholder-gray-500 dark:placeholder-dark-muted transition-colors">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400 dark:text-dark-muted"></i>
                        </div>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open" class="relative p-2 text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-bell text-lg"></i>
                        <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">3</span>
                    </button>
                    
                    <!-- Notifications Dropdown -->
                    <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-80 bg-white dark:bg-dark-surface rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1 z-50 transition-colors" style="display: none;">
                        <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-600">
                            <h3 class="text-sm font-medium text-gray-900 dark:text-dark-text">Notifications</h3>
                        </div>
                        <div class="max-h-64 overflow-y-auto">
                            <a href="#" class="block px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-600 transition-colors">
                                <div class="flex items-start">
                                    <div class="bg-blue-50 dark:bg-blue-900/20 p-2 rounded-full mr-3 mt-0.5">
                                        <i class="fas fa-user text-blue-600 dark:text-blue-400 text-xs"></i>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-900 dark:text-dark-text">New user registration</p>
                                        <p class="text-xs text-gray-500 dark:text-dark-muted mt-1">2 minutes ago</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="px-4 py-2 border-t border-gray-100 dark:border-gray-600">
                            <a href="#" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300">View all notifications</a>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions - Hidden on mobile -->
                <div class="hidden sm:block">
                    <button class="p-2 text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-plus text-lg"></i>
                    </button>
                </div>
                
                <!-- User Menu -->
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open" class="flex items-center space-x-3 text-sm focus:outline-none rounded-lg p-2 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <div class="w-8 h-8 bg-indigo-600 dark:bg-indigo-700 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white text-sm"></i>
                        </div>
                        <span class="hidden sm:block text-gray-700 dark:text-dark-text font-medium"><%= user.name %></span>
                        <i class="hidden sm:block fas fa-chevron-down text-gray-400 dark:text-dark-muted text-xs"></i>
                    </button>
                    
                    <!-- User Dropdown Menu -->
                    <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-48 bg-white dark:bg-dark-surface rounded-md shadow-lg border border-gray-200 dark:border-gray-600 py-1 z-50 transition-colors" style="display: none;">
                        <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-600">
                            <p class="text-sm font-medium text-gray-900 dark:text-dark-text"><%= user.name %></p>
                            <p class="text-xs text-gray-500 dark:text-dark-muted">Administrator</p>
                        </div>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-user-circle mr-2 w-4 text-center"></i>Profile
                        </a>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-cog mr-2 w-4 text-center"></i>Settings
                        </a>
                        <a href="#" @click.prevent="toggleDarkMode()" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-moon dark:fas fa-sun mr-2 w-4 text-center"></i>
                            <span x-text="isDark ? 'Light Mode' : 'Dark Mode'">Dark Mode</span>
                        </a>
                        <div class="border-t border-gray-100 dark:border-gray-600 my-1"></div>
                        <a href="/logout" class="block px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <i class="fas fa-sign-out-alt mr-2 w-4 text-center"></i>Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div x-show="mobileMenuOpen" x-transition class="lg:hidden bg-white dark:bg-dark-surface border-t border-gray-200 dark:border-gray-600 transition-colors" style="display: none;">
        <!-- Mobile Search -->
        <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-600">
            <div class="relative">
                <input type="text" placeholder="Search..." class="w-full pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm bg-white dark:bg-dark-card text-gray-900 dark:text-dark-text placeholder-gray-500 dark:placeholder-dark-muted transition-colors">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400 dark:text-dark-muted"></i>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Items -->
        <div class="px-2 py-3 space-y-1">
            <a href="/dashboard" class="block px-3 py-2 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'dashboard' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                <i class="fas fa-tachometer-alt w-5 text-center mr-3"></i>
                Dashboard
            </a>
            
            <a href="/users" class="block px-3 py-2 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'users' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                <i class="fas fa-users w-5 text-center mr-3"></i>
                Users
            </a>
            
            <a href="/products" class="block px-3 py-2 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'products' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                <i class="fas fa-box w-5 text-center mr-3"></i>
                Products
            </a>
            
