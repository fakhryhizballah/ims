<header class="bg-white dark:bg-dark-surface shadow-sm border-b border-gray-200 dark:border-gray-600 transition-colors duration-200" x-data="{ mobileMenuOpen: false }">
    <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Mobile menu button -->
            <div class="lg:hidden">
                <button @click="mobileMenuOpen = !mobileMenuOpen" class="p-2 rounded-md text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-colors">
                    <span class="sr-only">Open main menu</span>
                    <i class="fas fa-bars text-lg" x-show="!mobileMenuOpen"></i>
                    <i class="fas fa-times text-lg" x-show="mobileMenuOpen" style="display: none;"></i>
                </button>
            </div>

            <!-- Logo and Title -->
            <div class="flex items-center flex-1 lg:flex-initial">
                <div class="lg:hidden flex items-center justify-center flex-1">
                    <div class="flex items-center">
                        <i class="fas fa-cube text-indigo-600 dark:text-indigo-400 text-xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-900 dark:text-dark-text">MyApp</span>
                    </div>
                </div>
                <div class="hidden lg:block">
                    <h1 class="text-2xl font-semibold text-gray-900 dark:text-dark-text"><%= title %></h1>
                </div>
            </div>
            
            <!-- Desktop Navigation & User Menu -->
            <div class="flex items-center space-x-4">
           

                <!-- Quick Actions - Hidden on mobile -->
                <div class="hidden sm:block">
                    <button class="p-2 text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-plus text-lg"></i>
                    </button>
                </div>
                
                <!-- User Menu -->
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open" class="flex items-center space-x-3 text-sm focus:outline-none rounded-lg p-2 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <div class="w-8 h-8 bg-indigo-600 dark:bg-indigo-700 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white text-sm"></i>
                        </div>
                        <span class="hidden sm:block text-gray-700 dark:text-dark-text font-medium"><%= user.name %></span>
                        <i class="hidden sm:block fas fa-chevron-down text-gray-400 dark:text-dark-muted text-xs"></i>
                    </button>
                    
                    <!-- User Dropdown Menu -->
                    <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-48 bg-white dark:bg-dark-surface rounded-md shadow-lg border border-gray-200 dark:border-gray-600 py-1 z-50 transition-colors" style="display: none;">
                        <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-600">
                            <p class="text-sm font-medium text-gray-900 dark:text-dark-text"><%= user.name %></p>
                            <p class="text-xs text-gray-500 dark:text-dark-muted">Administrator</p>
                        </div>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-user-circle mr-2 w-4 text-center"></i>Profile
                        </a>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-cog mr-2 w-4 text-center"></i>Settings
                        </a>
                        <a href="#" @click.prevent="toggleDarkMode()" class="block px-4 py-2 text-sm text-gray-700 dark:text-dark-muted hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-moon dark:fas fa-sun mr-2 w-4 text-center"></i>
                            <span x-text="isDark ? 'Light Mode' : 'Dark Mode'">Dark Mode</span>
                        </a>
                        <div class="border-t border-gray-100 dark:border-gray-600 my-1"></div>
                        <a href="/logout" class="block px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <i class="fas fa-sign-out-alt mr-2 w-4 text-center"></i>Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div x-show="mobileMenuOpen" 
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 lg:hidden" 
         style="display: none;">
        
        <!-- Overlay -->
        <div class="fixed inset-0 bg-black bg-opacity-50" @click="mobileMenuOpen = false"></div>
        
        <!-- Mobile Menu Panel -->
        <div class="relative bg-white dark:bg-dark-surface w-80 h-full shadow-xl">
            <div class="flex flex-col h-full">
                <!-- Mobile Menu Header -->
                <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-600">
                    <div class="flex items-center">
                        <i class="fas fa-cube text-indigo-600 dark:text-indigo-400 text-xl mr-2"></i>
                        <span class="text-xl font-bold text-gray-900 dark:text-dark-text">MyApp</span>
                    </div>
                    <button @click="mobileMenuOpen = false" class="p-2 rounded-md text-gray-400 dark:text-dark-muted hover:text-gray-600 dark:hover:text-dark-text">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>

                <!-- Mobile Menu Items -->
                <div class="flex-1 px-4 py-3 space-y-1 overflow-y-auto">
                    <a href="/dashboard" @click="mobileMenuOpen = false" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'dashboard' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                        <i class="fas fa-tachometer-alt w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Dashboard</span>
                    </a>
                    
                    <a href="/users" @click="mobileMenuOpen = false" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'users' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                        <i class="fas fa-users w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Users</span>
                    </a>
                    
                    <a href="/products" @click="mobileMenuOpen = false" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'products' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                        <i class="fas fa-box w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Products</span>
                    </a>
                    
                    <a href="/reports" @click="mobileMenuOpen = false" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors <%= page === 'reports' ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400' : '' %>">
                        <i class="fas fa-chart-bar w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Reports</span>
                    </a>
                    
                    <div class="border-t border-gray-200 dark:border-gray-600 my-3"></div>
                    
                    <a href="#" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                        <i class="fas fa-cog w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Settings</span>
                    </a>

                    <button @click.prevent="toggleDarkMode()" class="w-full flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-left">
                        <i class="fas fa-moon dark:fas fa-sun w-6 text-center mr-3"></i>
                        <span class="text-base font-medium" x-text="isDark ? 'Light Mode' : 'Dark Mode'">Toggle Theme</span>
                    </button>

                    <a href="#" class="flex items-center px-3 py-3 rounded-lg text-gray-700 dark:text-dark-muted hover:bg-indigo-50 dark:hover:bg-indigo-900/20 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                        <i class="fas fa-plus w-6 text-center mr-3"></i>
                        <span class="text-base font-medium">Quick Add</span>
                    </a>
                </div>

                <!-- Mobile Menu Footer -->
                <div class="p-4 border-t border-gray-200 dark:border-gray-600">
                    <div class="flex items-center mb-3">
                        <div class="w-10 h-10 bg-indigo-600 dark:bg-indigo-700 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-gray-900 dark:text-dark-text"><%= user.name %></p>
                            <p class="text-xs text-gray-500 dark:text-dark-muted">Administrator</p>
                        </div>
                    </div>
                    <a href="/logout" class="w-full flex items-center justify-center px-4 py-2 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        <span class="font-medium">Logout</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>