<!DOCTYPE html>
<html lang="id" x-data="themeStore()">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %>- Ims Apps</title>
    <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 dark:bg-dark-bg transition-colors duration-200 overflow-x-hidden">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { page: page }) %>
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <!-- Header -->
            <%- include('../partials/header', { user: user, title: title }) %>
            
            <!-- Main Content Area -->
            <main class="flex-1 overflow-auto bg-gray-50 dark:bg-dark-bg p-4 sm:p-6 transition-colors duration-200">
              

                <!-- Charts and Tables -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
         

                    <!-- Quick Actions -->
                    <div class="bg-white dark:bg-dark-surface rounded-lg shadow-sm border border-gray-200 dark:border-gray-600 p-6 transition-colors duration-200">
                        <div class="p-6 border-b border-gray-200 dark:border-gray-600">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-dark-text">Tindakan Cepat</h3>
                        </div>
                        <div class="p-6">
                            <div class="grid grid-cols-2 gap-4">
                                <a href="/gudang/barangmasuk" class="flex flex-col items-center p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors dark:bg-blue-900/20">
                                    <i class="fas fa-truck-arrow-right text-blue-600 text-2xl mb-2 dark:text-blue-400"></i>
                                    <span class="text-sm font-medium text-blue-900 dark:text-blue-400">Barang Masuk</span>
                                </a>
                                
                                <a href="/products" class="flex flex-col items-center p-4 bg-green-50 rounded-lg hover:bg-green-100 transition-colors dark:bg-green-900/20">
                                    <i class="fas fa-plus text-green-600 text-2xl mb-2 dark:text-green-400"></i>
                                    <span class="text-sm font-medium text-green-900 dark:text-green-400">Tambahkan Produk</span>
                                </a>
                                
                                <a href="/gudang/barangkeluar" class="flex flex-col items-center p-4 bg-yellow-50 rounded-lg hover:bg-yellow-100 transition-colors dark:bg-yellow-900/20">
                                    <i class="fas fa-chart-line text-yellow-600 text-2xl mb-2 dark:text-yellow-400"></i>
                                    <span class="text-sm font-medium text-yellow-900 dark:text-yellow-400">Barang Keluar</span>
                                </a>
                                <a href="/gudang/barangkeluar" class="flex flex-col items-center p-4 bg-yellow-50 rounded-lg hover:bg-yellow-100 transition-colors dark:bg-yellow-900/20">
                                     <i class="fas fa-cog text-purple-600 text-2xl mb-2 dark:text-purple-400"></i>
                                    <span class="text-sm font-medium text-yellow-900 dark:text-yellow-400">Stok Opname Depo</span>
                                </a>
                            </div>
                            </main>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>